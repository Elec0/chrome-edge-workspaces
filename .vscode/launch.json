    "version": "0.2.0",
    "configurations": [
        {
            "command": "npm run watch",
            "name": "Run npm watch",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "command": "npm run watch-firefox",
            "name": "Run npm watch firefox",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome with Edge Workspaces",
            "url": "chrome-extension://feehlkcbifmladjmmpkghfokcngfkkkp/popup.html",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${workspaceFolder}.vscode/chrome-dev-profile"
        },
        {
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "name": "Launch Firefox with add-on",
            "addonPath": "${workspaceFolder}/build/firefox",
            "url": "about:debugging#/runtime/this-firefox",
        }
    ]
}
